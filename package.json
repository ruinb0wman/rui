{
  "name": "@ruinb0w/ui",
  "version": "1.0.0",
  "description": "跨项目 Vue 3 组件库 —— 单一视觉尺度 + 可切换语义主题 + AI 可读清单（AI.md / ai/manifest.json）",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/style.css",
    "./ai/manifest.json": "./ai/manifest.json",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./composables/*": {
      "types": "./dist/composables/*.d.ts",
      "import": "./dist/composables/*.js"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "ai",
    "AI.md",
    "DESIGN.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/style.css",
    "**/tokens.css"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vue-tsc --noEmit",
    "prepare": "npm run build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:style": "bun scripts/check-style.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:tokens": "bun scripts/gen-tokens.ts",
    "gen:docs": "bun scripts/gen-docs.ts",
    "gen:ai": "bun scripts/gen-ai.ts",
    "gen:all": "bun run gen:tokens && bun run gen:docs && bun run gen:ai",
    "docs:dev": "bun run gen:all && vitepress dev docs --port 8580 --host 127.0.0.1",
    "docs:build": "bun run gen:all && vitepress build docs",
    "check": "bun run gen:all && bun run lint && bun run typecheck && bun run test && bun run docs:build"
  },
  "peerDependencies": {
    "@lucide/vue": "^1.21.0",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@lucide/vue": "^1.21.0",
    "@types/node": "^26.0.1",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-vue": "^4.3.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^4.4.5",
    "vite-plugin-dts": "^3.9.1",
    "vitepress": "^1.6.3",
    "vitest": "^4.1.9",
    "vue": "^3.3.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.3.5"
  }
}
