{
  "name": "@ruinb0w/ui",
  "version": "1.0.0",
  "entry": "@ruinb0w/ui",
  "styleEntry": "@ruinb0w/ui/style.css",
  "themes": [
    "gofund-light",
    "gofund-dark",
    "bow-dark",
    "exp1-dark"
  ],
  "defaultTheme": "gofund-light",
  "themeSwitch": "document.documentElement.dataset.theme = \"<theme>\"",
  "densities": [
    "compact",
    "default",
    "touch"
  ],
  "densitySwitch": "document.documentElement.dataset.density = \"compact|default|touch\"",
  "rules": {
    "colors": "只用语义变量（--bg-*/--text-*/--border-*/--color-*），禁止在组件外写死色值",
    "spacing": "只用 --space-* 档位（2/4/8/12/16/24/32/48），禁止裸 px",
    "radius": "只用 --radius-sm|md|lg|full（6/10/16/999），控件 sm、卡片 md、弹窗 lg",
    "controlSize": "控件高度读 --control-h / --control-h-sm，字号读 --font-ui，不要自己写 px",
    "motion": "过渡只用 var(--motion-fast|base) + var(--motion-ease)",
    "zIndex": "浮层层级用 --z-sticky|dropdown|modal|toast，禁止 9999",
    "overrides": "允许在项目内覆盖语义变量，禁止覆盖组件内部 scoped 样式",
    "noCssFramework": "不引入 Tailwind/UnoCSS，不写 @apply，也不做 Tailwind @theme 适配层；只有本库没盖住的样式才在项目里手写 CSS"
  },
  "scale": {
    "radius": {
      "--radius-sm": "6px",
      "--radius-md": "10px",
      "--radius-lg": "16px",
      "--radius-full": "999px"
    },
    "space": {
      "--space-05": "2px",
      "--space-1": "4px",
      "--space-2": "8px",
      "--space-3": "12px",
      "--space-4": "16px",
      "--space-5": "24px",
      "--space-6": "32px",
      "--space-7": "48px"
    },
    "font": {
      "--font-xs": "12px",
      "--font-sm": "13px",
      "--font-base": "14px",
      "--font-md": "15px",
      "--font-lg": "18px",
      "--font-xl": "24px",
      "--leading-tight": "1.4",
      "--leading-base": "1.6"
    },
    "motion": {
      "--motion-fast": "120ms",
      "--motion-base": "200ms",
      "--motion-ease": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "z": {
      "--z-sticky": "10",
      "--z-dropdown": "100",
      "--z-modal": "3000",
      "--z-toast": "4000"
    }
  },
  "density": {
    "compact": {
      "--control-h": "28px",
      "--control-h-sm": "24px",
      "--control-px": "10px",
      "--font-ui": "13px"
    },
    "default": {
      "--control-h": "32px",
      "--control-h-sm": "26px",
      "--control-px": "12px",
      "--font-ui": "14px"
    },
    "touch": {
      "--control-h": "44px",
      "--control-h-sm": "36px",
      "--control-px": "16px",
      "--font-ui": "15px"
    }
  },
  "components": [
    {
      "name": "BButton",
      "file": "src/components/BButton.vue",
      "summary": "按钮。6 种语义色 × 3 档尺寸，支持 plain/round/circle/text/link/loading。",
      "when": [
        "表单提交与主操作",
        "打开弹窗/抽屉的触发点",
        "危险操作入口（type=\"danger\"）",
        "工具栏图标按钮（circle + icon）"
      ],
      "notFor": [
        "页面跳转（用 <a> 或路由链接，按钮不承担导航）",
        "纯装饰性图形"
      ],
      "props": {
        "type": "default | primary | success | warning | danger | info",
        "size": "large | default | small",
        "plain": "浅底描边样式",
        "round": "全圆角胶囊",
        "circle": "圆形（配 icon 用）",
        "text": "无底无边的文字按钮",
        "link": "链接样式按钮",
        "loading": "加载态并禁用点击",
        "disabled": "禁用",
        "nativeType": "button | submit | reset",
        "icon": "图标名（Lucide），渲染在文字左侧"
      },
      "tokens": [
        "--color-primary",
        "--color-danger",
        "--control-h",
        "--radius-sm",
        "--motion-fast"
      ],
      "a11y": "原生 <button>，键盘可聚焦；仅图标时用 aria-label 说明动作",
      "usage": "<div style=\"display:flex;gap:8px;flex-wrap:wrap\">\n  <BButton type=\"primary\">主操作</BButton>\n  <BButton>次操作</BButton>\n  <BButton type=\"danger\" plain>删除</BButton>\n  <BButton type=\"primary\" loading>提交中</BButton>\n  <BButton size=\"small\" text>文字按钮</BButton>\n  <BButton size=\"small\" circle icon=\"Plus\" />\n</div>"
    },
    {
      "name": "BInput",
      "file": "src/components/BInput.vue",
      "summary": "输入框 / 密码框 / 文本域（type=\"textarea\"），带清空、字数统计、前缀图标。",
      "when": [
        "单行文本、搜索、密码",
        "多行备注（type=\"textarea\" + autosize）"
      ],
      "notFor": [
        "数字输入（用 BInputNumber）",
        "日期/时间（用 BDatePicker / BTimePicker）",
        "下拉选择（用原生 <select> 或列表组件）"
      ],
      "props": {
        "modelValue": "v-model 值",
        "type": "text | password | textarea 等原生 input type",
        "size": "large | default | small",
        "placeholder": "占位文本",
        "clearable": "显示清空按钮",
        "showPassword": "密码可见切换",
        "showWordLimit": "显示字数 x/maxlength",
        "maxlength": "最大长度",
        "rows": "textarea 行数",
        "autosize": "textarea 自适应高度",
        "prefixIcon": "前缀图标名",
        "suffixIcon": "后缀图标名",
        "formatter": "显示值格式化（(v) => string）",
        "parser": "回写值解析（(v) => string | number）"
      },
      "tokens": [
        "--bg-card",
        "--border-default",
        "--control-h",
        "--radius-sm"
      ],
      "a11y": "label 用外部 <label for> 关联，不要只靠 placeholder",
      "usage": "<div style=\"display:grid;gap:8px;max-width:320px\">\n  <BInput v-model=\"text\" placeholder=\"输入点什么\" clearable prefix-icon=\"Search\" />\n  <BInput v-model=\"text\" type=\"textarea\" :rows=\"2\" show-word-limit :maxlength=\"40\" placeholder=\"多行备注\" />\n</div>"
    },
    {
      "name": "BInputNumber",
      "file": "src/components/BInputNumber.vue",
      "summary": "数字输入，min/max/step/precision 钳制，带加减控件。",
      "when": [
        "金额、份额、期数、阈值等数值字段",
        "需要上下键微调的场景"
      ],
      "notFor": [
        "纯文本数字（如基金代码）—— 用 BInput 保留前导 0"
      ],
      "props": {
        "modelValue": "v-model 数字值",
        "min": "最小值（默认 Number.MIN_SAFE_INTEGER）",
        "max": "最大值",
        "step": "步长，默认 1",
        "precision": "小数位",
        "stepStrictly": "强制对齐步长",
        "controls": "是否显示加减按钮",
        "controlsPosition": "default | right",
        "valueOnClear": "清空后回填的值"
      },
      "tokens": [
        "--bg-card",
        "--border-default",
        "--control-h",
        "--radius-sm"
      ],
      "usage": "<div style=\"max-width:220px\">\n  <BInputNumber v-model=\"amount\" :min=\"0\" :max=\"100000\" :step=\"100\" />\n  <p style=\"margin-top:8px;color:var(--text-secondary);font-size:var(--font-sm)\">当前值：{{ amount }}</p>\n</div>"
    },
    {
      "name": "BCheckbox",
      "file": "src/components/BCheckbox.vue",
      "summary": "复选框，支持半选（indeterminate）。",
      "when": [
        "多选列表",
        "「全选」控制子项（indeterminate）",
        "单个开关式确认（同意条款）"
      ],
      "notFor": [
        "立即生效的开关（用 BSwitch）",
        "互斥选项（用 BRadioGroup）"
      ],
      "props": {
        "modelValue": "v-model 布尔值",
        "label": "右侧文案",
        "indeterminate": "半选态（视觉，不改变值）",
        "disabled": "禁用",
        "size": "large | default | small"
      },
      "tokens": [
        "--color-primary",
        "--border-default",
        "--radius-sm"
      ],
      "usage": "<div style=\"display:grid;gap:8px\">\n  <BCheckbox v-model=\"checked\" label=\"已选中的选项\" />\n  <BCheckbox :model-value=\"false\" indeterminate label=\"半选（全选用的视觉态）\" />\n  <BCheckbox :model-value=\"false\" disabled label=\"禁用\" />\n</div>"
    },
    {
      "name": "BSwitch",
      "file": "src/components/BSwitch.vue",
      "summary": "开关，立即生效型布尔切换。",
      "when": [
        "设置项即时开关",
        "启用/停用某个功能"
      ],
      "notFor": [
        "提交时才生效的表单项（用 BCheckbox）"
      ],
      "props": {
        "modelValue": "v-model 布尔值",
        "activeText": "开启时文案",
        "inactiveText": "关闭时文案",
        "loading": "加载态",
        "disabled": "禁用",
        "size": "large | default | small"
      },
      "tokens": [
        "--color-primary",
        "--bg-hover",
        "--motion-fast"
      ],
      "a11y": "role=\"switch\"，空格/回车切换",
      "usage": "<div style=\"display:grid;gap:8px\">\n  <BSwitch v-model=\"on\" active-text=\"已启用\" inactive-text=\"已停用\" />\n  <BSwitch :model-value=\"false\" disabled />\n</div>"
    },
    {
      "name": "BRadio",
      "file": "src/components/BRadio.vue",
      "summary": "单选按钮，必须放在 BRadioGroup 内使用（值由 group 提供）。",
      "when": [
        "BRadioGroup 的子项"
      ],
      "notFor": [
        "单独使用（没有 group 上下文时值不会同步）"
      ],
      "props": {
        "value": "该项的值",
        "label": "右侧文案",
        "disabled": "单项禁用"
      },
      "tokens": [
        "--color-primary",
        "--control-h"
      ],
      "usage": "<BRadioGroup v-model=\"picked\">\n  <BRadio value=\"a\" label=\"选项 A\" />\n  <BRadio value=\"b\" label=\"选项 B\" />\n  <BRadio value=\"c\" label=\"选项 C（禁用）\" disabled />\n</BRadioGroup>"
    },
    {
      "name": "BRadioGroup",
      "file": "src/components/BRadioGroup.vue",
      "summary": "单选组，provide/inject 管理子项状态，可横向/纵向/描边。",
      "when": [
        "2–5 个互斥选项、且选项少到值得全部展示",
        "周期选择（每周/每月/每季）"
      ],
      "notFor": [
        "选项超过 6 个（用 <select> 或列表）",
        "多选（用 BCheckbox）"
      ],
      "props": {
        "modelValue": "v-model 当前值",
        "disabled": "整组禁用",
        "size": "large | default | small",
        "vertical": "纵向排列",
        "border": "每项加描边"
      },
      "tokens": [
        "--color-primary",
        "--border-default",
        "--control-h"
      ],
      "usage": "<div style=\"display:grid;gap:12px\">\n  <BRadioGroup v-model=\"period\">\n    <BRadio value=\"weekly\" label=\"每周\" />\n    <BRadio value=\"monthly\" label=\"每月\" />\n    <BRadio value=\"quarterly\" label=\"每季\" />\n  </BRadioGroup>\n  <BRadioGroup v-model=\"period\" border>\n    <BRadio value=\"weekly\" label=\"描边式\" />\n    <BRadio value=\"monthly\" label=\"描边式 B\" />\n  </BRadioGroup>\n</div>"
    },
    {
      "name": "BDatePicker",
      "file": "src/components/BDatePicker.vue",
      "summary": "日期选择（原生 date input 的封装，带图标与清空）。",
      "when": [
        "交易日期、定投起始日等日期字段"
      ],
      "notFor": [
        "需要日历面板/范围选择的场景（当前只封装原生控件，移动端要自己换成 wheel picker）"
      ],
      "props": {
        "modelValue": "v-model 日期字符串（YYYY-MM-DD）",
        "placeholder": "占位文本",
        "clearable": "显示清空按钮",
        "min": "最小日期",
        "max": "最大日期",
        "size": "large | default | small"
      },
      "tokens": [
        "--bg-card",
        "--border-default",
        "--control-h"
      ],
      "usage": "<div style=\"max-width:220px\"><BDatePicker v-model=\"date\" clearable /></div>"
    },
    {
      "name": "BTimePicker",
      "file": "src/components/BTimePicker.vue",
      "summary": "时间选择（原生 time input 的封装）。",
      "when": [
        "提醒时间、交易时间点"
      ],
      "notFor": [
        "需要滚动轮盘（移动端）—— 页面自己实现，别硬套"
      ],
      "props": {
        "modelValue": "v-model 时间字符串（HH:mm）",
        "placeholder": "占位文本",
        "clearable": "显示清空按钮",
        "min": "最小时间",
        "max": "最大时间",
        "step": "秒级步长，默认 60",
        "size": "large | default | small"
      },
      "tokens": [
        "--bg-card",
        "--border-default",
        "--control-h"
      ],
      "usage": "<div style=\"max-width:180px\"><BTimePicker v-model=\"at\" clearable /></div>"
    },
    {
      "name": "BFileInput",
      "file": "src/components/BFileInput.vue",
      "summary": "文件选择（隐藏原生 input，trigger 插槽自定义外观）。",
      "when": [
        "导入 CSV/图片",
        "需要自定义上传按钮外观时"
      ],
      "notFor": [
        "拖拽上传（未实现 drop 区域）",
        "需要上传进度（本组件不负责传输）"
      ],
      "props": {
        "accept": "可接受的文件类型",
        "multiple": "多选",
        "disabled": "禁用",
        "placeholder": "未选择时的文案"
      },
      "tokens": [
        "--bg-card",
        "--border-default",
        "--radius-sm"
      ],
      "usage": "<div style=\"max-width:320px\"><BFileInput accept=\".csv\" placeholder=\"选择一个 CSV 文件\" /></div>"
    },
    {
      "name": "BaseModal",
      "file": "src/components/BaseModal.vue",
      "summary": "模态框底座（Teleport + 遮罩 + header/body/footer 三槽 + 移动端底部弹出）。",
      "when": [
        "需要承载任意内容的弹窗（表单、详情）",
        "需要 footer 操作区的确认流程"
      ],
      "notFor": [
        "只要两三个按钮的确认（用 BDialog 更轻）",
        "页面内联展开（用 BCard）"
      ],
      "props": {
        "visible": "v-model 式的可见标志（配合 @close）",
        "title": "标题（也可用 header 插槽）",
        "width": "宽度 px 或字符串，默认 min(60vw, 900px)",
        "height": "高度，默认 min(60vh, 600px)",
        "closable": "显示右上角关闭",
        "closeOnOverlay": "点遮罩关闭"
      },
      "tokens": [
        "--bg-overlay",
        "--bg-card",
        "--shadow-lg",
        "--radius-lg",
        "--z-modal"
      ],
      "a11y": "目前缺焦点陷阱与 ESC 关闭（M2 补齐）；遮罩点击关闭已支持",
      "usage": "<BButton type=\"primary\" @click=\"open = true\">打开弹窗</BButton>\n<BaseModal :visible=\"open\" title=\"示例弹窗\" width=\"480\" height=\"auto\" @close=\"open = false\">\n  <p style=\"color:var(--text-secondary)\">弹窗正文，可放表单或详情。</p>\n  <template #footer>\n    <BButton @click=\"open = false\">取消</BButton>\n    <BButton type=\"primary\" @click=\"open = false\">确定</BButton>\n  </template>\n</BaseModal>"
    },
    {
      "name": "BDialog",
      "file": "src/components/BDialog.vue",
      "summary": "轻量确认/选择对话框：给一组带图标的选项，点击直接返回选项值。",
      "when": [
        "「导出还是打印」这类 2–4 个带图标的选择",
        "需要图标+副标题的确认框"
      ],
      "notFor": [
        "承载复杂表单（用 BaseModal）",
        "只有「确定/取消」（用 BaseModal + footer 更直白）"
      ],
      "props": {
        "visible": "可见标志",
        "title": "标题，默认「确认」",
        "subtitle": "副标题",
        "options": "选项数组 { icon, title, desc, value, danger }",
        "closable": "显示关闭按钮"
      },
      "tokens": [
        "--bg-overlay",
        "--bg-card",
        "--shadow-md",
        "--radius-md"
      ],
      "a11y": "role=\"dialog\" + aria-label；选项是可点击 div，M2 换成 button",
      "usage": "<BButton type=\"primary\" @click=\"open = true\">打开选择框</BButton>\n<BDialog :visible=\"open\" title=\"怎么处理这份数据？\" subtitle=\"选择后立即生效\" :options=\"options\" @select=\"open = false\" @cancel=\"open = false\" />"
    },
    {
      "name": "BCard",
      "file": "src/components/BCard.vue",
      "summary": "内容卡片容器，shadow 三档 + 可选 header 渐变。",
      "when": [
        "页面内的内容分组",
        "需要 hover 抬起的可点击卡片（shadow=\"hover\"）"
      ],
      "notFor": [
        "页面级布局（用页面自己的 grid/flex）",
        "弹窗容器（用 BaseModal）"
      ],
      "props": {
        "shadow": "always | hover | never",
        "header": "标题文本（也可用 header 插槽）",
        "bodyStyle": "正文区内联样式对象"
      },
      "tokens": [
        "--bg-card",
        "--border-default",
        "--shadow-sm",
        "--radius-md"
      ],
      "usage": "<div style=\"display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(180px,1fr))\">\n  <BCard header=\"默认卡片\"><p style=\"color:var(--text-secondary)\">shadow=always</p></BCard>\n  <BCard header=\"悬浮抬起\" shadow=\"hover\"><p style=\"color:var(--text-secondary)\">shadow=hover</p></BCard>\n  <BCard shadow=\"never\"><p style=\"color:var(--text-secondary)\">shadow=never</p></BCard>\n</div>"
    },
    {
      "name": "SkeletonCard",
      "file": "src/components/SkeletonCard.vue",
      "summary": "卡片骨架屏（shimmer 动画），数据未到位时的占位。",
      "when": [
        "列表/卡片首次加载",
        "轮询刷新时保持布局不跳动"
      ],
      "notFor": [
        "耗时 >3s 且需要说明进度（用进度或文案）"
      ],
      "props": {
        "lines": "占位行数，默认 3",
        "widths": "每行宽度数组（如 [\"100%\",\"60%\"]）",
        "height": "卡片高度，默认 120",
        "title": "是否显示标题占位条"
      },
      "tokens": [
        "--bg-subtle",
        "--border-subtle",
        "--radius-md"
      ],
      "usage": "<div style=\"max-width:320px\"><SkeletonCard :lines=\"3\" :widths=\"['100%','72%','45%']\" title /></div>"
    },
    {
      "name": "SkeletonChart",
      "file": "src/components/SkeletonChart.vue",
      "summary": "图表骨架屏（虚线走势 + 图例占位）。",
      "when": [
        "K 线/走势图加载中"
      ],
      "notFor": [
        "非图表区域（用 SkeletonCard）"
      ],
      "props": {
        "height": "高度，默认 300",
        "width": "宽度，默认 300"
      },
      "tokens": [
        "--bg-subtle",
        "--border-subtle",
        "--radius-md"
      ],
      "usage": "<div style=\"max-width:420px\"><SkeletonChart :height=\"180\" :width=\"420\" /></div>"
    },
    {
      "name": "ErrorBoundary",
      "file": "src/components/ErrorBoundary.vue",
      "summary": "渲染错误捕获，失败时显示提示 + 重试按钮。",
      "when": [
        "包住易崩的第三方图表/富文本区域"
      ],
      "notFor": [
        "包裹整个应用（页面级错误交给路由 onError）",
        "异步请求失败（那不是渲染错误）"
      ],
      "props": {
        "—": "无 props，默认插槽即受保护内容"
      },
      "tokens": [
        "--color-warning",
        "--bg-card"
      ],
      "usage": "<ErrorBoundary>\n  <p style=\"color:var(--text-secondary)\">这层内容一旦渲染抛错，就会替换成「渲染异常 + 重试」。</p>\n</ErrorBoundary>"
    },
    {
      "name": "OfflineBanner",
      "file": "src/components/OfflineBanner.vue",
      "summary": "断网提示条（顶栏 sticky，online/offline 事件驱动）。",
      "when": [
        "应用级布局顶部放一条，浏览器离线时自动出现"
      ],
      "notFor": [
        "接口报错提示（那是请求层的事）"
